# Tempora configuration (12-factor). Every variable has a matching CLI flag;
# flags override the environment. See README "Configuration reference".

# --- Listeners ---------------------------------------------------------------
TEMPORA_HTTP_ADDR=:8080
TEMPORA_TCP_ADDR=:9090

# --- Rules -------------------------------------------------------------------
TEMPORA_RULES=/app/rules

# --- Engine ------------------------------------------------------------------
# 0 = GOMAXPROCS
TEMPORA_SHARDS=0
TEMPORA_RING_SIZE=16384
TEMPORA_BATCH_SIZE=256
TEMPORA_ALLOWED_LATENESS=2s
TEMPORA_IDLE_ADVANCE=5s
TEMPORA_MAX_KEYS_PER_SHARD=262144
TEMPORA_KEY_TTL=10m
TEMPORA_DROP_ON_FULL=false

# --- Durability (write-ahead log) --------------------------------------------
TEMPORA_WAL_DIR=/data/wal
# none | interval | always
TEMPORA_WAL_SYNC=interval
TEMPORA_WAL_SYNC_EVERY=200ms
TEMPORA_WAL_SEGMENT_BYTES=67108864
TEMPORA_WAL_RETAIN=16
TEMPORA_REPLAY=true

# --- Alert delivery -----------------------------------------------------------
# stdout | <file path> | empty to disable
TEMPORA_ALERT_LOG=stdout
TEMPORA_WEBHOOK_URL=
TEMPORA_WEBHOOK_SECRET=
TEMPORA_HUB_SIZE=2000
TEMPORA_SINK_QUEUE=8192

# --- API / security -----------------------------------------------------------
TEMPORA_MAX_BODY_BYTES=8388608
# When set, mutating endpoints require "Authorization: Bearer <token>".
TEMPORA_AUTH_TOKEN=
TEMPORA_PPROF=false

# --- Logging / lifecycle ------------------------------------------------------
TEMPORA_LOG_LEVEL=info
TEMPORA_LOG_FORMAT=json
TEMPORA_SHUTDOWN_GRACE=15s
